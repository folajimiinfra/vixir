# ---- API (apps/api) ----
VIXIR_DB_URL=jdbc:postgresql://localhost:5432/vixir
VIXIR_DB_USER=vixir
VIXIR_DB_PASSWORD=vixir
VIXIR_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
VIXIR_SERVICE_SECRET=change-me-too-another-long-random-string-32b
VIXIR_WEB_ORIGINS=http://localhost:5173
# Optional. JWT/service secrets must be >= 32 bytes (HS256) and different from each other.
# Auth endpoints: requests per minute per client IP and per email (default 10).
VIXIR_AUTH_RATE_LIMIT_PER_MINUTE=10
# How the API finds the client IP behind a proxy: native (trust X-Forwarded-For from private-range proxies), none.
VIXIR_FORWARD_HEADERS_STRATEGY=native
GOOGLE_CLIENT_ID=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ---- Web (apps/web) — must start with VITE_ ----
VITE_API_URL=http://localhost:8081
# ---- Vix agent (apps/vix-agent) ----
VIXIR_API_URL=http://localhost:8081/api/v1
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
