{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vixir.org/schema/experiment.schema.json",
  "title": "Vixir experiment config",
  "type": "object",
  "required": ["id", "version", "subject", "title", "aim", "level", "curricula", "minutes", "apparatus", "variables", "instruments", "model", "analysis", "rubric", "procedure", "precautions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]{3}\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "subject": { "enum": ["PHYSICS", "CHEMISTRY", "BIOLOGY", "ELECTRONICS", "ENGINEERING"] },
    "title": { "type": "string", "minLength": 3 },
    "aim": { "type": "string" },
    "level": { "type": "array", "items": { "enum": ["SS1", "SS2", "SS3", "ND", "HND", "100L", "200L"] }, "minItems": 1 },
    "curricula": { "type": "array", "items": { "enum": ["waec", "neco", "nuc", "nbte"] } },
    "minutes": { "type": "integer", "minimum": 5 },
    "hazards": { "type": "array", "items": { "type": "object", "required": ["name", "text"], "properties": { "name": { "type": "string" }, "text": { "type": "string" } } } },
    "apparatus": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "spec": { "type": "string" }, "requires": { "type": "array", "items": { "type": "string" } } } } },
    "variables": { "type": "object", "additionalProperties": { "type": "object", "required": ["role", "unit"], "properties": { "role": { "enum": ["independent", "measured", "controlled", "random"] }, "unit": { "type": "string" }, "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "default": { "type": "number" }, "label": { "type": "string" } } } },
    "instruments": { "type": "object", "additionalProperties": { "type": "object", "required": ["kind", "resolution"], "properties": { "kind": { "enum": ["scale", "timer", "meter", "gauge"] }, "resolution": { "type": "number", "exclusiveMinimum": 0 }, "zeroError": { "type": "number" }, "parallaxBound": { "type": "number" }, "reactionSigma": { "type": "number" }, "ranges": { "type": "array", "items": { "type": "number" } } } } },
    "model": { "type": "string", "pattern": "^builtin:[a-z-]+@\\d+$" },
    "hidden": { "type": "object", "additionalProperties": { "type": "object", "required": ["range"], "properties": { "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "unit": { "type": "string" } } } },
    "analysis": { "type": "object", "required": ["plot", "derive", "tolerance"], "properties": { "plot": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }, "derive": { "type": "string" }, "tolerance": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 }, "minPoints": { "type": "integer", "minimum": 3 } } },
    "rubric": { "type": "object", "required": ["criteria"], "properties": { "criteria": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["key", "label", "max", "rule"], "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "max": { "type": "integer", "minimum": 1 }, "rule": { "enum": ["readings", "table", "graph", "slope", "derived", "precautions"] } } } } } },
    "procedure": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "precautions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["text", "keywords"], "properties": { "text": { "type": "string" }, "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } } },
    "glossary": { "type": "object", "additionalProperties": { "type": "string" } },
    "tours": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "object", "required": ["regionId", "caption"], "properties": { "regionId": { "type": "string" }, "caption": { "type": "string" } } } } },
    "sources": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
